                <mxCell id="tech-content" value="• Framework: Google ADK (Agent Development Kit)&#10;• LLM: LiteLLM (Multi-model Support)&#10;• PDF Parsing: MinerU / PyPDF&#10;• Frontend: React + TypeScript + Ant Design&#10;• Backend: FastAPI + WebSocket&#10;• Concurrency: asyncio.Semaphore" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="470" y="640" width="350" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="flow-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="860" y="610" width="700" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="flow-title" value="🔄 Core Workflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="870" y="615" width="200" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="flow-content" value="1. PDF Input → MinerU Parsing → content_list.json&#10;2. DocumentChunker + DocIndex Structure Analysis → TitleContentBlock&#10;3. SemanticLabeler LLM Classification → SemanticChunk (with Tags)&#10;4. Semantic Pool builds Domain Index → semantic_pool.json&#10;5. Orchestrator dispatches → appraise_all concurrent appraisal of 23 items&#10;6. IterativeEvaluator: Load Context → Extract Excerpts → Score → Synthesize&#10;7. Reporter aggregates → 6 Domain Scores + Recommendation → appraisal_report.json" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="870" y="638" width="680" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
