# ============================================
# AMA 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ============================================
# LLM 配置 (OpenAI 兼容格式)
# ============================================
# 提供商: vllm / openai_compatible / openai / anthropic / deepseek / gemini / dashscope / zhipu
LLM_PROVIDER=vllm

# 大模型 API 基础地址；OpenAI 兼容服务填写到 /v1，例如 http://localhost:8000/v1
LLM_BASE_URL=

# API Key (如果你的服务需要认证)
LLM_API_KEY=

# 默认模型名称
LLM_MODEL_NAME=

# 读取超时时间 (秒)：流式响应中相邻两段数据的最长间隔，不限制长输出的总耗时
LLM_TIMEOUT=

# ============================================
# MinerU 远程服务配置 (VLM HTTP Client)
# ============================================
# VLM 服务地址 (OpenAI 兼容格式)
# 直连 vLLM 服务（内网地址，末尾加 / 保留完整路径）
MINERU_SERVER_URL=
# 直连模式不需要指定 model_name，会自动从服务获取
MINERU_MODEL_NAME=

# VLM 服务 API Key
MINERU_API_KEY=

# VLM 请求超时时间 (秒)
MINERU_HTTP_TIMEOUT=600

# VLM 最大并发请求数
MINERU_MAX_CONCURRENCY=100

# ============================================
# ASR 配置 (可选，仅用于解析视频附件；OpenAI 兼容格式)
# ============================================
ASR_SERVER_URL=
ASR_API_KEY=
ASR_MODEL_NAME=
ASR_TIMEOUT=
ASR_MAX_CONCURRENCY=1

# ============================================
# 应用配置
# ============================================
# 输入目录 (存放待处理的 PDF 文件)
DIR_INPUT=./input

# 输出目录 (任务结果存放位置)
DIR_OUTPUT=./output

# ============================================
# Web 登录认证
# ============================================
# 是否启用 Web 登录认证
AMA_AUTH_ENABLED=true
# 会话签名密钥（生产环境务必显式配置）
AMA_AUTH_SECRET=
# LLM 运行时配置加密密钥（生产环境务必显式配置）
LLM_CONFIG_SECRET=
# 登录会话有效期（小时）
AMA_AUTH_SESSION_TTL_HOURS=12
# 首批账号：数据库为空且首次启动时，从项目根目录的 users.json 导入（格式见 README）

# ============================================
# MCP 单 PDF 评价服务
# ============================================
# 启用后必须配置一个非空 API Key
AMA_MCP_ENABLED=false
AMA_MCP_API_KEY=
# MCP JSON 和 multipart 上传请求体上限 15 MiB；PDF 原始文件上限 10 MiB
AMA_MCP_MAX_REQUEST_BYTES=15728640
AMA_MCP_MAX_INFLIGHT_REQUESTS=8
AMA_MCP_MAX_PDF_BYTES=10485760
AMA_MCP_MAX_PDF_PAGES=1000
# 最多同时处理 4 个 PDF，其余任务进入 SQLite FIFO 队列
AMA_MCP_MAX_CONCURRENT_JOBS=4
AMA_MCP_MAX_QUEUED_JOBS=32
AMA_MCP_LEASE_SECONDS=120
AMA_MCP_HEARTBEAT_SECONDS=10
AMA_MCP_RECOVERY_LIMIT=1
AMA_MCP_POLL_INTERVAL_SECONDS=1
# 低于 2 GiB 时暂停提交和新任务领取；设为 0 可关闭
AMA_MCP_MIN_FREE_DISK_BYTES=2147483648
# 终态任务输入保留 24 小时；失败/取消/旧运行目录保留 7 天；完成结果保留 30 天
AMA_MCP_INPUT_RETENTION_HOURS=24
AMA_MCP_INCOMPLETE_RETENTION_DAYS=7
AMA_MCP_RESULT_RETENTION_DAYS=30
AMA_MCP_CLEANUP_INTERVAL_SECONDS=3600
# ============================================
# 评价并发配置
# ============================================
# 评价引擎: llm / rule / hybrid
ANALYSIS_ENGINE=hybrid
# Rule 路径失败时是否回退 LLM（degraded 策略下仅作为总开关；legacy 策略下严格条目仍直接失败）
RULE_ENGINE_FALLBACK_ON_ERROR=true
RULE_ENGINE_BATCH_SIZE=5
# ============================================
# 规则引擎可靠性配置（详见 docs/RULE_ENGINE_RELIABILITY_PLAN.md）
# ============================================
# 抽取值策略：keep_valid=保留合法对象并记录修复失败标记；strict=整批拒绝；quarantine=同 keep_valid
RULE_EXTRACTION_POLICY=keep_valid
# 抽取批次的本地修复轮数（0=不修复）
RULE_EXTRACTION_REPAIR_ATTEMPTS=1
# 回退策略：degraded=模型输出类失败允许回退并标记 degraded；legacy=严格条目直接失败
RULE_FALLBACK_POLICY=degraded
# legacy 策略下的严格条目（逗号分隔；degraded 下仅记录级别）
RULE_STRICT_ITEMS=item_11,item_12,item_18,item_19,item_21
# 路由评估时按标签排除的 chunk（附录不默认排除：领域标签映射决定是否参与；标题整体为参考文献/修订历史/索引的章节另行排除，可在 ItemSpec 中追加）
RULE_ROUTING_EXCLUDED_LABELS=Irrelevant
# 附录 chunk 路由得分折扣（1=不折扣）与单条目附录上限（0=自动 min(3, max(2, max_chunks//4))）
RULE_APPENDIX_SCORE_FACTOR=0.25
RULE_APPENDIX_MAX_CHUNKS=0
# 是否在条目评价结束后写出 failure_report.json
RULE_REPORT_FAILURES=true
# 单条目恢复配额：传输 / 截断 / 修复总 / 单阶段修复 / 合计
LLM_RETRY_QUOTA_TRANSPORT=3
LLM_RETRY_QUOTA_TRUNCATION=3
LLM_RETRY_QUOTA_REPAIR=6
LLM_RETRY_QUOTA_REPAIR_STAGE=2
LLM_RETRY_QUOTA_TOTAL=8
# 单个指南任务的条目评价最大并发数 (默认 5，建议 3-8)
APPRAISAL_MAX_CONCURRENCY=5
# Appraiser 全局线程池最大并发数 (默认 10)
APPRAISAL_POOL_MAX_CONCURRENCY=10
BATCH_MINERU_MAX_CONCURRENCY=2
BATCH_REPORTER_MAX_CONCURRENCY=2
# 文件复制、缓存恢复和文档预处理线程数 (默认 4)
BATCH_BLOCKING_MAX_CONCURRENCY=4
# 进程内所有 LLM 调用共享最大并发数 (默认 60)
LLM_GLOBAL_MAX_CONCURRENCY=60
# 结构化输出模式：auto（默认，自动降级）/ json_schema / guided_json / json_object
# LLM_STRUCTURED_OUTPUT=auto
# 批量 Worker 租约有效期 (默认 120 秒)
BATCH_WORKER_LEASE_SECONDS=120
# 批量 Worker 租约续期间隔 (默认 10 秒)
BATCH_WORKER_HEARTBEAT_SECONDS=10
# 租约过期后的回收宽限期 (默认 60 秒)
BATCH_WORKER_RECOVERY_GRACE_SECONDS=60
# 语义标签分类最大并发数 (默认 8，批量任务建议 3-8)
LABELER_MAX_CONCURRENCY=8

# 模型实际部署的上下文窗口（tokens）；也可在管理台配置
# LLM_CONTEXT_WINDOW=131072
