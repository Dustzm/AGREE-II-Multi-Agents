# ============================================
# KG-Weaver 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ============================================
# LLM 配置 (OpenAI 兼容格式)
# ============================================
# 大模型 API 基础地址 (不包含 /v1 后缀)
LLM_BASE_URL=

# API Key (如果你的服务需要认证)
LLM_API_KEY=

# 默认模型名称
LLM_MODEL_NAME=

# 请求超时时间 (秒)
LLM_TIMEOUT=

# ============================================
# MinerU 远程服务配置 (VLM HTTP Client)
# ============================================
# VLM 服务地址 (OpenAI 兼容格式)
# 直连 vLLM 服务（内网地址，末尾加 / 保留完整路径）
MINERU_SERVER_URL=
# 直连模式不需要指定 model_name，会自动从服务获取
MINERU_MODEL_NAME=

# VLM 服务 API Key
MINERU_API_KEY=

# VLM 请求超时时间 (秒)
MINERU_HTTP_TIMEOUT=600

# VLM 最大并发请求数
MINERU_MAX_CONCURRENCY=100

# ============================================
# VLM 配置 (OpenAI 兼容格式)
# ============================================
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL_NAME=
VLM_TIMEOUT=

# ============================================
# ASR 配置 (OpenAI 兼容格式)
# ============================================
ASR_SERVER_URL=
ASR_API_KEY=
ASR_MODEL_NAME=
ASR_TIMEOUT=80
ASR_MAX_CONCURRENCY=1

# ============================================
# 应用配置
# ============================================
# 运行环境: development / production
APP_ENV=development

# 输入目录 (存放待处理的 PDF 文件)
DIR_INPUT=./input

# 输出目录 (任务结果存放位置)
DIR_OUTPUT=./output

# ============================================
# 评价并发配置
# ============================================
# 条目评价最大并发数 (默认 5，建议 3-8)
APPRAISAL_MAX_CONCURRENCY=5
