# ============================================
# KG-Weaver 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ============================================
# LLM 配置 (OpenAI 兼容格式)
# ============================================
# 大模型 API 基础地址 (不包含 /v1 后缀)
LLM_BASE_URL=http://localhost:8080/v1

# API Key (如果你的服务需要认证)
LLM_API_KEY=your-api-key-here

# 默认模型名称
LLM_MODEL_NAME=qwen2.5

# 请求超时时间 (秒)
LLM_TIMEOUT=120

# ============================================
# MinerU 远程服务配置 (VLM HTTP Client)
# ============================================
# VLM 服务地址 (OpenAI 兼容格式)
# 重要：如果 URL 有中间路径（如 /modelhub），末尾必须加 / 否则会被截断
MINERU_SERVER_URL=http://127.0.0.1:30000/

# VLM 模型名称（若经过模型平台中转，需指定此项）
MINERU_MODEL_NAME=

# VLM 服务 API Key (用于 Authorization Bearer 认证)
MINERU_API_KEY=your-vlm-api-key

# VLM 请求超时时间 (秒)
MINERU_HTTP_TIMEOUT=600

# VLM 最大并发请求数
MINERU_MAX_CONCURRENCY=100

# ============================================
# 应用配置
# ============================================
# 运行环境: development / production
APP_ENV=development

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 输入目录 (存放待处理的 PDF 文件)
DIR_INPUT=./input

# 输出目录 (任务结果存放位置)
DIR_OUTPUT=./output
